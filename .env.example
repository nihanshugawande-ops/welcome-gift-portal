# Welcome Gift Portal - Environment Configuration Template
# Copy this file to .env and configure your secure variables.
# Never commit .env or secrets to version control. Read variables only on the server.

# -----------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# 2. Admin Authentication & Security Secrets
# -----------------------------------------------------------------------------
# ADMIN_USERNAME: Username required for protected administrator access
ADMIN_USERNAME="admin"

# ADMIN_PASSWORD: High-entropy secret password for admin dashboard access
ADMIN_PASSWORD="WelcomeGift@Admin2026"

# SESSION_SECRET: 256-bit cryptographic secret for session signing and timing-safe validation
SESSION_SECRET="super-secret-random-key-for-sessions-change-in-production-2026"

# -----------------------------------------------------------------------------
# 3. Optional SMS Verification Gateway Providers (Twilio / Fast2SMS)
# -----------------------------------------------------------------------------
# If configured with real provider credentials, real SMS OTPs will be dispatched.
# If unconfigured, the portal honestly reports that SMS delivery is not configured,
# and allows users to proceed with consent-based registration without simulating fake OTPs.

# Twilio Configuration (Optional)
# TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
# TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"

# Fast2SMS Configuration (Optional)
# FAST2SMS_API_KEY="your_fast2sms_api_key_here"

# Generic SMS Provider API Key (Optional)
# SMS_PROVIDER_API_KEY="your_sms_gateway_api_key_here"
